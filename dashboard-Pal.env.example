# ============================================================================
# これは【見本】です。git に追跡されているので、実際の値を書かないでください。
#
#   本番 : /etc/dashboard-Pal.env    (600 root:root, systemd が読む)
#          sudo install -o root -g root -m 600 dashboard-Pal.env.example /etc/dashboard-Pal.env
#   開発 : .dev/local.env            (600, .gitignore 済み, dev.sh が読む)
#
# 非秘密の開発用設定は scripts/dev.sh が既に export しています。
# 変えたいときだけ .dev/local.env に書けば上書きされます。
# ============================================================================

# 実行環境ラベル（staging / production）。UI のバッジに出る
PAL_ENV=production

# --- Palworld 専用サーバの REST API ---
# PalWorldSettings.ini で RESTAPIEnabled=True / RESTAPIPort=8212 / AdminPassword を設定しておく
PAL_HOST=127.0.0.1
PAL_PORT=8212
PAL_ADMIN_USER=admin
PAL_ADMIN_PASSWORD=CHANGE_ME
# 参照系（info/metrics/players）のタイムアウト。画面が1秒ごとに叩くので短く
PAL_TIMEOUT=5
# 実行系（save/shutdown/stop）のタイムアウト。
# 実機のワールド保存は数十秒かかることがある。短いとタイムアウトを
# 「保存失敗」と誤認して再起動が毎回中止される
PAL_SLOW_TIMEOUT=120

# --- この管理ツール ---
APP_HOST=0.0.0.0
APP_PORT=8080
# 管理画面のログイン。
#
# ★ 初期パスワードはありません。空のままだと認証そのものが無効になり、
#   ネットワークが届く誰でもサーバの停止や BAN ができてしまいます。
#   本番では必ず設定してください。
#
# 設定すると「操作」にログインが必要になります。閲覧はログインなしでできます
# （パスワード系の設定値だけは、閲覧でも伏字にして返します）。
# 見られること自体が困る場合は、リバースプロキシ側で手前を塞いでください。
#
# ログイン画面（ブラウザ）と Basic 認証（curl 等）の両方でこの組み合わせを使います。
APP_USER=admin
APP_PASSWORD=
# ログイン状態を保つ時間（秒）。既定は7日
APP_SESSION_TTL=604800
# セッションの署名鍵。空なら生成してファイルに保存する。
# 複数台で同じセッションを使いたい場合だけ明示的に揃える
APP_SESSION_SECRET=
APP_SESSION_SECRET_FILE=/var/lib/dashboard-Pal/session-secret
# ログイン失敗が続いたときに一時的に受け付けなくする
APP_LOGIN_MAX_ATTEMPTS=10
APP_LOGIN_LOCKOUT_SEC=300

# --- ゲームサーバのプロセス制御 ---
# lgsm（本番）、mock / simulated（開発）
#
#   lgsm      … LinuxGSM 構成。管理スクリプト（pwserver 等）を直接呼ぶ。
#               LinuxGSM は tmux でゲームを起動する完結したプロセス管理ツールなので、
#               上に systemd を重ねると「落ちてたら起こす」役目が二人になり競合する
#   mock      … 同梱モックサーバを起動・停止する（開発）
#   simulated … 何もしない（テスト）
#
# ★ ゲームサーバの systemd 運用は本番では廃止しました。
#   PAL_SERVICE_BACKEND=systemd は手元で systemd 管理のサーバを触るときだけ。
#   本番で選ぶと起動時に警告が出ます（sudoers / polkit の設定ミスという
#   失敗クラスがそのまま戻ってくるため: issue #28）
PAL_SERVICE_BACKEND=lgsm

# LinuxGSM の管理スクリプトの絶対パス。
# 管理ツールと同じユーザで動かすこと（sudo は使いません）
PAL_SERVICE_COMMAND=/home/mntuser/pwserver

# 起動/停止コマンドの待ち時間（秒）。
# LinuxGSM の start/stop は数十秒で終わる。ここまで待たされるのは異常なので、
# その場合はスクリプトを手で叩いて所要時間を測ること
PAL_SERVICE_TIMEOUT=300

PAL_MOCK_CONTROL_URL=http://127.0.0.1:8212

# --- 設定ファイルとバックアップ ---
# LinuxGSM 構成では ${rootdir}/serverfiles の下。rootdir は LinuxGSM を
# 導入したユーザの home（この環境では /home/mntuser）
PAL_SETTINGS_INI=/home/mntuser/serverfiles/Pal/Saved/Config/LinuxServer/PalWorldSettings.ini
PAL_BACKUP_DIR=/var/lib/dashboard-Pal/backups
PAL_BACKUP_KEEP=30

# --- ワールドセーブのバックアップ ---
# 空にしておくと PAL_SETTINGS_INI の場所から推測する。
#   .../Pal/Saved/Config/LinuxServer/PalWorldSettings.ini
#   → .../Pal/Saved/SaveGames
# 推測が外れる構成のときだけ明示する。確認:
#   ls -d "$(dirname PAL_SETTINGS_INI の値)/../../SaveGames"
PAL_SAVE_DIR=
PAL_WORLD_BACKUP_DIR=/var/lib/dashboard-Pal/world-backups
# 1つ数百MBになるので既定は少なめ
PAL_WORLD_BACKUP_KEEP=5

# --- 再起動シーケンス ---
# 画面で予約を作るときの初期値。実行時は画面/APIの指定が優先される
RESTART_NOTICE_OFFSETS=300,60,30
RESTART_SHUTDOWN_WAIT=10
# 上の待ち時間のあと、実際にサーバが落ちるのを待つ猶予（秒）。
# 短いとワールド保存の途中で停止処理に進んでしまう
RESTART_SHUTDOWN_GRACE=120
# 再起動後、サーバが起動しきるまで「応答なし」を通知しない時間（秒）。
# 起動コマンドは即座に返るが、実機は接続を受け付けるまで数十秒かかる
RESTART_ALERT_GRACE=180
# 起動コマンドのあと、サーバが応答を返すまで待つ上限（秒）。0 で待たない。
# ここまで見て初めて「再起動が完了した」と言える。確認できなかった場合は
# 完了通知に警告が付く（コマンドは通ったのに上がってこない、を見逃さないため）
RESTART_STARTUP_TIMEOUT=180
RESTART_DEBOUNCE_SEC=60
# 予告が終わってから完了までの打ち切り時間（秒）。0 で無効。
# 保存・shutdown API・停止待ち・プロセス制御コマンドはそれぞれ自前のタイムアウトを
# 持つので、ここはそのどれもが返らなかったときの最後の砦。進行中の表示が残ると
# 以後の停止も起動も弾かれるため、必ずどこかで終わらせる（issue #34）。
# 短くすると正常な再起動を途中で失敗扱いにしてしまうので、
# PAL_SLOW_TIMEOUT + RESTART_SHUTDOWN_GRACE + PAL_SERVICE_TIMEOUT より十分長くすること
RESTART_SEQUENCE_TIMEOUT=900
# 予告アナウンスの初期文面。{time} が残り時間に置き換わる
RESTART_ANNOUNCE_TEMPLATE=サーバーは{time}後に再起動します。
STOP_ANNOUNCE_TEMPLATE=サーバーは{time}後に停止します。

# --- 不意の停止からの復旧 (issue #41) ---
# 管理ツールは自分の意思と無関係に止められる。OS のパッケージ更新のあと
# needrestart が systemctl restart を打つためで、1回の自動更新で数秒のうちに
# 2〜3回落とされることもある。サーバを止めてから起こすまでの間にそれが起きると、
# ゲームが落ちたまま誰も気づかない。以下はそれを防ぐための3点セット。
#
# シーケンスの進行状態の保存先。次の起動でここを読んで中断を拾う
PAL_RESTART_STATE=/var/lib/dashboard-Pal/restart-state.json
# 管理ツールの停止時、サーバに触っている最中のシーケンスを待つ上限（秒）。
# ★ ユニットの TimeoutStopSec より必ず短くすること（既定は 90 秒）。
#   長いと待っている途中で SIGKILL され、待った意味が無くなる
RESTART_DRAIN_TIMEOUT=45
# 中断されたシーケンスを自動で救済起動してよい上限（秒）。
# これより古い中断は通知だけにする（何時間も前に止めたサーバを、
# 管理ツールの都合で勝手に起こさないため）
RESTART_RECOVER_MAX_AGE=3600
# 管理ツール自身の稼働記録（前回いつ止まったか）の保存先
PAL_RUNTIME_STATE=/var/lib/dashboard-Pal/runtime-state.json
# 停止から何秒以内の復帰を「外部要因の可能性あり」として通知するか
PAL_QUICK_RESTART_SEC=60

# --- 設定変更の予約（保留中の変更） ---
PAL_PENDING_STORE=/var/lib/dashboard-Pal/pending-settings.json
PAL_PENDING_LIMIT=50

# --- アナウンス履歴 ---
PAL_ANNOUNCE_STORE=/var/lib/dashboard-Pal/announcements.json
ANNOUNCE_HISTORY_LIMIT=500

# --- スケジューラ ---
SCHEDULE_TIMEZONE=Asia/Tokyo
PAL_SCHEDULE_STORE=/var/lib/dashboard-Pal/schedules.json

# --- 監視 ---
# ゲームサーバへの問い合わせをまとめる秒数。
# 画面のタブを何枚開いても、この間隔以上には問い合わせが増えない
STATUS_CACHE_SEC=1

MONITOR_INTERVAL=30
HISTORY_SIZE=2880
MEM_WARN_PERCENT=80
MEM_CRIT_PERCENT=90
ALERT_COOLDOWN_SEC=1800

# --- Steam アップデートの検知（issue #30 / Phase 1） ---
# LinuxGSM 構成（PAL_SERVICE_BACKEND=lgsm）でだけ動く。
# 素の SteamCMD 構成では更新に権限昇格が要るので、機能ごと出さない。
#
# **いまは検知して画面と Discord に出すだけで、サーバには触らない。**
# 適用は当面まだ cron の update-watch.sh 側（読むだけなので併存して害は無い）。
#
# check-update を叩く間隔（秒）。cron が */10 で回っている間は
# それより短くしても得は無い
PAL_UPDATE_CHECK_INTERVAL=600
# 検知の状態。再起動をまたいで同じ更新の通知を繰り返さないために永続化する
PAL_UPDATE_STATE=/var/lib/dashboard-Pal/update-state.json
# 何回続けて失敗したら Discord に流すか。
# 「検知が黙って止まる」（現行 cron のロック残留）を作らないための仕掛け
PAL_UPDATE_FAIL_ALERTS=3

# --- Discord 通知 ---
# 通常通知と警報を別チャンネルに分けたい場合は2つ設定する
#
# ※このファイルは git 管理下のサンプルです。実際の Webhook URL は書かないこと。
#   本番: /etc/dashboard-Pal.env（600, root:root）に書く
#   開発: .dev/local.env に書く（.gitignore 済み。dev.sh が読み込みます）
DISCORD_WEBHOOK_URL=
DISCORD_ALERT_WEBHOOK_URL=

# --- ログ配信 ---
# ログ画面に流すゲームサーバ側のログの取り込み元。file / journald / none
#
# LinuxGSM は journald ではなく自前のログファイルに書くので file を使う。
# journald のままだと存在しないユニットを tail し続けて1行も出ない
# （journalctl -u は存在しないユニット名でもエラーにならない）
LOG_SOURCE=file
LOG_FILE=/home/mntuser/log/console/pwserver-console.log

# 管理ツール自身のログの詳しさ。DEBUG / INFO / WARNING / ERROR
# 画面と journalctl -u dashboard-Pal の両方に効く。
# 原因を追うときだけ DEBUG に落とす（プロセス制御コマンドの実行1件ごとに行が増える）
LOG_LEVEL=INFO

# 破壊的操作（kick/ban/shutdown）を実行せず記録だけしたい場合は true
PAL_DRY_RUN=false
