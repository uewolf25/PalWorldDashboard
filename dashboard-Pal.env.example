# /etc/dashboard-Pal.env
# 権限は 600 / root:root にすること（AdminPassword と Webhook URL が入るため）
#   sudo install -o root -g root -m 600 dashboard-Pal.env.example /etc/dashboard-Pal.env

# 実行環境ラベル（staging / production）。UI のバッジに出る
PAL_ENV=production

# --- Palworld 専用サーバの REST API ---
# PalWorldSettings.ini で RESTAPIEnabled=True / RESTAPIPort=8212 / AdminPassword を設定しておく
PAL_HOST=127.0.0.1
PAL_PORT=8212
PAL_ADMIN_USER=admin
PAL_ADMIN_PASSWORD=CHANGE_ME
PAL_TIMEOUT=5

# --- この管理ツール ---
APP_HOST=0.0.0.0
APP_PORT=8080
# 設定すると管理画面に Basic 認証がかかる（空なら無認証。LAN 内限定で使うこと）
APP_USER=admin
APP_PASSWORD=

# --- ゲームサーバの systemd ユニット ---
PAL_SERVICE_NAME=palworld.service

# --- 設定ファイルとバックアップ ---
PAL_SETTINGS_INI=/home/steam/Steam/steamapps/common/PalServer/Pal/Saved/Config/LinuxServer/PalWorldSettings.ini
PAL_BACKUP_DIR=/var/lib/dashboard-Pal/backups
PAL_BACKUP_KEEP=30

# --- 再起動シーケンス ---
# 画面で予約を作るときの初期値。実行時は画面/APIの指定が優先される
RESTART_NOTICE_OFFSETS=300,60,30
RESTART_SHUTDOWN_WAIT=10
RESTART_DEBOUNCE_SEC=60
# 予告アナウンスの初期文面。{time} が残り時間に置き換わる
RESTART_ANNOUNCE_TEMPLATE=サーバーは{time}後に再起動します。
STOP_ANNOUNCE_TEMPLATE=サーバーは{time}後に停止します。

# --- アナウンス履歴 ---
PAL_ANNOUNCE_STORE=/var/lib/dashboard-Pal/announcements.json
ANNOUNCE_HISTORY_LIMIT=500

# --- スケジューラ ---
SCHEDULE_TIMEZONE=Asia/Tokyo
PAL_SCHEDULE_STORE=/var/lib/dashboard-Pal/schedules.json

# --- 監視 ---
MONITOR_INTERVAL=30
HISTORY_SIZE=2880
MEM_WARN_PERCENT=80
MEM_CRIT_PERCENT=90
ALERT_COOLDOWN_SEC=1800

# --- Discord 通知 ---
# 通常通知と警報を別チャンネルに分けたい場合は2つ設定する
DISCORD_WEBHOOK_URL=
DISCORD_ALERT_WEBHOOK_URL=

# --- ログ配信 ---
# journald / file / none
LOG_SOURCE=journald
LOG_FILE=/var/log/palworld.log

# 破壊的操作（kick/ban/shutdown）を実行せず記録だけしたい場合は true
PAL_DRY_RUN=false
