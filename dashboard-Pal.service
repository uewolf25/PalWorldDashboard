[Unit]
Description=dashboard-Pal (Palworld Server Manager Web UI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mntuser
Group=mntuser
WorkingDirectory=/opt/dashboard-Pal/backend
EnvironmentFile=/etc/dashboard-Pal.env
ExecStart=/opt/dashboard-Pal/backend/.venv/bin/uvicorn app.main:app --host ${APP_HOST} --port ${APP_PORT}
Restart=always
RestartSec=5

# バックアップとスケジュール定義の保存先
StateDirectory=dashboard-Pal
RuntimeDirectory=dashboard-Pal

# --- 最低限のサンドボックス ---
# 既定は PAL_SERVICE_BACKEND=systemd（素の SteamCMD 構成）向け。
# LinuxGSM 構成（PAL_SERVICE_BACKEND=lgsm）では下の「LinuxGSM の場合」を参照。
#
# NoNewPrivileges は付けない。付けると setuid の sudo が原理的に昇格できず、
# PAL_SYSTEMCTL_SUDO=true でのサーバ操作が start/stop/restart/is-active まとめて
# 全部失敗する（issue #28）。sudoers を正しく書いても直らない。
# ※ LinuxGSM 構成なら sudo を使わないので、NoNewPrivileges=true を足してよい。
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# PalWorldSettings.ini を書き換えるため、その配置先だけ書き込み許可する。
# ★ 実際の置き場に直すこと（既定は SteamCMD 標準の決め打ち）
ReadWritePaths=/home/steam/Steam/steamapps/common/PalServer/Pal/Saved/Config/LinuxServer

# --- LinuxGSM の場合はここを差し替える ---
# 管理スクリプト（pwserver 等）を呼ぶので、上の2行を次に置き換える。
#
#   # LinuxGSM は tmux のソケットを /tmp に作る。PrivateTmp=true だと
#   # 管理ツールから見える /tmp が別物になり、SSH から起動したセッションを
#   # 掴めない（その逆も）。停止も状態確認もすれ違う
#   PrivateTmp=false
#   # LinuxGSM は rootdir 配下にログ・ロック・serverfiles を書く。
#   # ini のディレクトリだけ開けても pwserver start が失敗する
#   ReadWritePaths=/home/mntuser
#
# ProtectHome=read-only はそのままでよい（他ユーザの home は保護されたまま）。

[Install]
WantedBy=multi-user.target
