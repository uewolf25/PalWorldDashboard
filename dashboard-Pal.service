[Unit]
Description=dashboard-Pal (Palworld Server Manager Web UI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mntuser
Group=mntuser
WorkingDirectory=/opt/dashboard-Pal/backend
EnvironmentFile=/etc/dashboard-Pal.env
ExecStart=/opt/dashboard-Pal/backend/.venv/bin/uvicorn app.main:app --host ${APP_HOST} --port ${APP_PORT}
Restart=always
RestartSec=5

# ★ 管理ツールの停止/再起動でゲームサーバを道連れにしないための必須設定。
#
# LinuxGSM の start はゲームを tmux に預ける。その tmux とゲーム本体は
# 管理ツールの子プロセスとして生まれるので、**このユニットの cgroup に入る**。
# 既定の KillMode=control-group だと systemd は停止時に cgroup 内を全部殺すため、
# 管理ツールを再起動しただけでゲームサーバまで落ちる。
#
# process にすると、停止時に殺すのは Main PID（uvicorn）だけになる。
# 残ったゲームサーバは次の起動時に "Found left-over process ... Ignoring" と
# 記録されるが、そのまま動き続ける（それが正しい）。
#
# cgroup に同居している影響は他にもある。MemoryMax / CPUQuota の類を足すと
# ゲームサーバごと締めることになるので、この2つは入れないこと。
KillMode=process

# 逆方向の道連れも塞ぐ。ゲームサーバが同じ cgroup に居るので、カーネルの
# OOM killer がゲームを殺すと、既定（OOMPolicy=stop）では systemd が
# このユニットまで止めてしまう。管理ツールが落ちると復旧操作もできなくなる
OOMPolicy=continue

# バックアップとスケジュール定義の保存先
StateDirectory=dashboard-Pal
RuntimeDirectory=dashboard-Pal

# --- 最低限のサンドボックス ---
# LinuxGSM 構成（PAL_SERVICE_BACKEND=lgsm）向け。ゲームサーバの systemd 運用は
# 廃止したので、sudo も sudoers も使わない。
#
# 特権昇格を使わないぶん、これを付けられる。issue #28 の失敗クラス
# （sudo と NoNewPrivileges の同居で全操作が失敗する）ごと消えている
NoNewPrivileges=true

# ★ PrivateTmp は false のままにすること。
# LinuxGSM は tmux のソケットを /tmp に作る（/tmp/tmux-<uid>/pwserver-<乱数>）。
# true にすると管理ツールから見える /tmp が別の名前空間になり、SSH から起動した
# セッションを掴めない（その逆も）。停止も状態確認もすれ違う
PrivateTmp=false

ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

# 他ユーザの home は読み取りのみ。書き込みは下の ReadWritePaths で開けた範囲だけ
ProtectHome=read-only
# ★ LinuxGSM を導入したユーザの home（rootdir）。実際の環境に合わせること。
# LinuxGSM は rootdir 配下にログ・ロック・serverfiles を書くので、
# PalWorldSettings.ini のディレクトリだけ開けても pwserver start が失敗する
ReadWritePaths=/home/mntuser

[Install]
WantedBy=multi-user.target
